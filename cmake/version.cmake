# Writes kevc_version.h: which commit this build is. Kev-C++ is versioned by commit date and time
# (UTC) plus the short hash, e.g. 2026.10.31.1959-3fa834c, so versions sort by when they were made.
# Run on every build (see CMakeLists.txt); the header is only rewritten when the commit changes.
#   cmake -DSOURCE_DIR=<repo> -DOUTPUT=<header> -P cmake/version.cmake
set(time 0)
set(commit "unknown")
set(text "unknown")
find_program(GIT git)
if(GIT)
  execute_process(COMMAND ${GIT} -C ${SOURCE_DIR} log -1 --format=%ct%n%h
                  OUTPUT_VARIABLE out RESULT_VARIABLE rc ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc EQUAL 0 AND out)
    string(REPLACE "\n" ";" parts "${out}")
    list(GET parts 0 time)
    list(GET parts 1 commit)
    # string(TIMESTAMP) formats SOURCE_DATE_EPOCH instead of now when it's set.
    set(ENV{SOURCE_DATE_EPOCH} ${time})
    string(TIMESTAMP stamp "%Y.%m.%d.%H%M" UTC)
    set(text "${stamp}-${commit}")
    # Local edits on top of the commit: say so, but keep the commit's time for comparisons.
    execute_process(COMMAND ${GIT} -C ${SOURCE_DIR} status --porcelain --untracked-files=no
                    OUTPUT_VARIABLE dirty ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(dirty)
      string(APPEND text "+changes")
    endif()
  endif()
endif()

set(content "// Generated by cmake/version.cmake: the commit this build was made from.
#pragma once
#define KEVC_BUILD_VERSION \"${text}\"
#define KEVC_BUILD_COMMIT \"${commit}\"
#define KEVC_BUILD_TIME ${time}LL // the commit's time, seconds since 1970 (UTC); 0 if unknown
")
if(EXISTS ${OUTPUT})
  file(READ ${OUTPUT} old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE ${OUTPUT} "${content}")
