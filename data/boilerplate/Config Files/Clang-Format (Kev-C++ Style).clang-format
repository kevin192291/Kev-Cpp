---
label: .clang-format (Kev-C++ Style)
description: Kev-C++'s C/C++ layout for Auto Format (Ctrl+I) and clang-format: braces on their own lines, 4 spaces
file: .clang-format
whole-file: yes
order: 21
section: editor
---
# Kev-C++'s C/C++ layout: braces on lines of their own for classes, functions, namespaces and control
# statements (not lambdas, initialisers or extern "C"), 4-space indents, 120 columns.
BasedOnStyle: LLVM
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 120
BreakBeforeBraces: Custom
BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: false
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  BeforeWhile: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false
AccessModifierOffset: -4
EmptyLineBeforeAccessModifier: Leave
NamespaceIndentation: All
FixNamespaceComments: false
IndentCaseLabels: false
DerivePointerAlignment: true
PointerAlignment: Left
SortIncludes: Never
AlwaysBreakTemplateDeclarations: Yes
AllowShortFunctionsOnASingleLine: Inline
AllowShortLambdasOnASingleLine: All
AllowShortBlocksOnASingleLine: Never
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
