# Copy to .env and fill in real values. .env holds secrets: keep it out of git.
# SvelteKit: PUBLIC_ variables may reach the browser ($env/static/public); the others stay on the
# server ($env/static/private).
PUBLIC_API_URL=http://localhost:5173/api
DATABASE_URL=postgres://user:password@localhost:5432/app
SESSION_SECRET=
