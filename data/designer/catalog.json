{
  "comment": "The GTK designer's palette and how each container holds children. slots: window (child + titlebar), single (one <child>), children (any number of <child>), typed (<child type=…> for each name, plus a property slot), properties (one object per named property), grid (<child> with <layout> column/row), pages (a page object per child), overlay (a main child, then <child type=\"overlay\">). defaults are the properties a new one gets; xml is added inside it.",
  "groups": ["Windows", "Containers", "Controls", "Display"],
  "classes": [
    {"class": "GtkApplicationWindow", "label": "Application Window", "group": "Windows", "slots": "window",
     "defaults": {"title": "Window", "default-width": "480", "default-height": "320"}},
    {"class": "GtkWindow", "label": "Window", "group": "Windows", "slots": "window",
     "defaults": {"title": "Window", "default-width": "480", "default-height": "320"}},

    {"class": "GtkBox", "label": "Box", "group": "Containers", "slots": "children",
     "defaults": {"orientation": "vertical", "spacing": "6"}},
    {"class": "GtkGrid", "label": "Grid", "group": "Containers", "slots": "grid",
     "defaults": {"row-spacing": "6", "column-spacing": "6"}},
    {"class": "GtkCenterBox", "label": "Center Box", "group": "Containers", "slots": "properties",
     "names": ["start-widget", "center-widget", "end-widget"]},
    {"class": "GtkPaned", "label": "Paned", "group": "Containers", "slots": "properties",
     "names": ["start-child", "end-child"], "defaults": {"vexpand": "True"}},
    {"class": "GtkScrolledWindow", "label": "Scrolled Window", "group": "Containers", "slots": "single",
     "defaults": {"vexpand": "True"}},
    {"class": "GtkFrame", "label": "Frame", "group": "Containers", "slots": "single",
     "defaults": {"label": "Frame"}},
    {"class": "GtkExpander", "label": "Expander", "group": "Containers", "slots": "single",
     "defaults": {"label": "Expander", "expanded": "True"}},
    {"class": "GtkRevealer", "label": "Revealer", "group": "Containers", "slots": "single",
     "defaults": {"reveal-child": "True"}},
    {"class": "GtkOverlay", "label": "Overlay", "group": "Containers", "slots": "overlay"},
    {"class": "GtkStack", "label": "Stack", "group": "Containers", "slots": "pages", "page": "GtkStackPage"},
    {"class": "GtkNotebook", "label": "Notebook", "group": "Containers", "slots": "pages", "page": "GtkNotebookPage"},
    {"class": "GtkHeaderBar", "label": "Header Bar", "group": "Containers", "slots": "typed",
     "names": ["start", "end"], "property": "title-widget"},
    {"class": "GtkActionBar", "label": "Action Bar", "group": "Containers", "slots": "typed",
     "names": ["start", "end"], "property": "center-widget"},
    {"class": "GtkListBox", "label": "List Box", "group": "Containers", "slots": "children",
     "defaults": {"selection-mode": "none"}},
    {"class": "GtkFlowBox", "label": "Flow Box", "group": "Containers", "slots": "children"},

    {"class": "GtkButton", "label": "Button", "group": "Controls", "defaults": {"label": "Button"}},
    {"class": "GtkToggleButton", "label": "Toggle Button", "group": "Controls", "defaults": {"label": "Toggle"}},
    {"class": "GtkCheckButton", "label": "Check Button", "group": "Controls", "defaults": {"label": "Check"}},
    {"class": "GtkSwitch", "label": "Switch", "group": "Controls", "defaults": {"halign": "start"}},
    {"class": "GtkMenuButton", "label": "Menu Button", "group": "Controls", "defaults": {"icon-name": "open-menu-symbolic"}},
    {"class": "GtkLinkButton", "label": "Link Button", "group": "Controls",
     "defaults": {"label": "Link", "uri": "https://www.gtk.org"}},
    {"class": "GtkEntry", "label": "Entry", "group": "Controls"},
    {"class": "GtkPasswordEntry", "label": "Password Entry", "group": "Controls", "defaults": {"show-peek-icon": "True"}},
    {"class": "GtkSearchEntry", "label": "Search Entry", "group": "Controls"},
    {"class": "GtkSpinButton", "label": "Spin Button", "group": "Controls",
     "xml": "<property name=\"adjustment\"><object class=\"GtkAdjustment\"><property name=\"upper\">100</property><property name=\"step-increment\">1</property><property name=\"page-increment\">10</property></object></property>"},
    {"class": "GtkScale", "label": "Scale", "group": "Controls", "defaults": {"draw-value": "True"},
     "xml": "<property name=\"adjustment\"><object class=\"GtkAdjustment\"><property name=\"upper\">100</property><property name=\"step-increment\">1</property><property name=\"value\">50</property></object></property>"},
    {"class": "GtkDropDown", "label": "Drop Down", "group": "Controls",
     "xml": "<property name=\"model\"><object class=\"GtkStringList\"><items><item>One</item><item>Two</item><item>Three</item></items></object></property>"},
    {"class": "GtkTextView", "label": "Text View", "group": "Controls",
     "defaults": {"wrap-mode": "word", "height-request": "80"}},

    {"class": "GtkLabel", "label": "Label", "group": "Display", "defaults": {"label": "Label"}},
    {"class": "GtkImage", "label": "Image", "group": "Display",
     "defaults": {"icon-name": "image-x-generic", "pixel-size": "48"}},
    {"class": "GtkPicture", "label": "Picture", "group": "Display"},
    {"class": "GtkSpinner", "label": "Spinner", "group": "Display", "defaults": {"spinning": "True"}},
    {"class": "GtkProgressBar", "label": "Progress Bar", "group": "Display", "defaults": {"fraction": "0.5"}},
    {"class": "GtkLevelBar", "label": "Level Bar", "group": "Display", "defaults": {"value": "0.5"}},
    {"class": "GtkSeparator", "label": "Separator", "group": "Display"},
    {"class": "GtkCalendar", "label": "Calendar", "group": "Display"}
  ]
}
