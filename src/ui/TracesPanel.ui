<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkPaned" id="TracesPanel">
    <property name="position">380</property>
    <property name="resize-start-child">false</property>
    <property name="start-child">
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="width-request">260</property>
        <child>
          <object class="GtkBox">
            <property name="spacing">6</property>
            <property name="margin-start">6</property>
            <property name="margin-end">6</property>
            <property name="margin-top">6</property>
            <property name="margin-bottom">6</property>
            <child>
              <object class="GtkLabel" id="status_">
                <property name="xalign">0</property>
                <property name="hexpand">true</property>
                <property name="ellipsize">end</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="clear_">
                <property name="label">Clear</property>
                <signal name="clicked" handler="on_clear_clicked"/>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <child>
              <object class="GtkListBox" id="list_">
                <child type="placeholder">
                  <object class="GtkLabel" id="hint_">
                    <property name="label">&lt;span alpha="75%"&gt;No traces yet. Kev-C++ collects SvelteKit's OpenTelemetry spans while it runs the app (Run or Debug). To send them: add &lt;tt&gt;tracing: { server: true }&lt;/tt&gt; to your SvelteKit config (&lt;tt&gt;sveltekit({ … })&lt;/tt&gt; in vite.config.ts on SvelteKit 3, svelte.config.js before), use an adapter such as &lt;tt&gt;@sveltejs/adapter-node&lt;/tt&gt; (adapter-auto refuses instrumentation), and create &lt;tt&gt;src/instrumentation.server.ts&lt;/tt&gt; that starts the OpenTelemetry &lt;tt&gt;NodeSDK&lt;/tt&gt; with an &lt;tt&gt;OTLPTraceExporter&lt;/tt&gt; from &lt;tt&gt;@opentelemetry/exporter-trace-otlp-http&lt;/tt&gt;. It sends to the address Kev-C++ puts in &lt;tt&gt;OTEL_EXPORTER_OTLP_ENDPOINT&lt;/tt&gt;.&lt;/span&gt;</property>
                    <property name="use-markup">true</property>
                    <property name="wrap">true</property>
                    <property name="xalign">0</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </property>
    <property name="end-child">
      <object class="GtkScrolledWindow">
        <child>
          <object class="GtkDrawingArea" id="canvas_">
            <property name="content-width">600</property>
          </object>
        </child>
      </object>
    </property>
  </object>
</interface>
