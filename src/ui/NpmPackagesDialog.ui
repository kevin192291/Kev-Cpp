<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="NpmPackagesDialog">
    <property name="title">Packages</property>
    <property name="default-width">1000</property>
    <property name="default-height">700</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">12</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>
        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkLabel">
                <property name="label">Where packages come from</property>
                <property name="xalign">0</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">8</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Package source:</property>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="source_">
                    <property name="hexpand">true</property>
                    <property name="placeholder-text">npm's public registry (https://registry.npmjs.org/)</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="login_">
                    <property name="label">Log In…</property>
                    <property name="tooltip-text">Sign in to this source (runs npm login in the Run tab; your token is kept in ~/.npmrc)</property>
                    <signal name="clicked" handler="on_login_clicked"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel">
                <property name="label">To use your company's own npm server (for private packages, or so every download goes through it), enter its address here. It's saved in this project's .npmrc, which npm, pnpm, yarn and bun all read, so everyone building the project uses it. Passwords and tokens are never saved there: Log In… keeps yours in your own ~/.npmrc.</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkExpander" id="scopesExpander_">
                <property name="label">Packages with a source of their own (@company/…)</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">18</property>
                    <property name="margin-top">6</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Packages whose names start with a scope, such as @company/ui, can come from another server than the rest.</property>
                        <property name="wrap">true</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="scopeList_">
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="addScope_">
                        <property name="label">Add a Scope</property>
                        <property name="halign">start</property>
                        <signal name="clicked" handler="on_add_scope_clicked"/>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkSeparator"/>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">6</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">8</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Packages</property>
                    <property name="xalign">0</property>
                    <property name="hexpand">true</property>
                    <style>
                      <class name="heading"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="checkStatus_">
                    <style>
                      <class name="dim-label"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="check_">
                    <property name="label">Check for Newer Versions</property>
                    <property name="tooltip-text">Ask the package source for each package's newest version</property>
                    <signal name="clicked" handler="on_check_clicked"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkScrolledWindow">
                <property name="vexpand">true</property>
                <property name="min-content-height">260</property>
                <child>
                  <object class="GtkGrid" id="grid_">
                    <property name="row-spacing">2</property>
                    <property name="column-spacing">14</property>
                    <property name="margin-end">8</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">&lt;small&gt;&lt;b&gt;Package&lt;/b&gt;&lt;/small&gt;</property>
                        <property name="use-markup">true</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                        <layout>
                          <property name="column">0</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">&lt;small&gt;&lt;b&gt;Version&lt;/b&gt;&lt;/small&gt;</property>
                        <property name="use-markup">true</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                        <layout>
                          <property name="column">1</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">&lt;small&gt;&lt;b&gt;Lock&lt;/b&gt;&lt;/small&gt;</property>
                        <property name="use-markup">true</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                        <layout>
                          <property name="column">2</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">&lt;small&gt;&lt;b&gt;Updates allowed&lt;/b&gt;&lt;/small&gt;</property>
                        <property name="use-markup">true</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                        <layout>
                          <property name="column">3</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">&lt;small&gt;&lt;b&gt;Installed&lt;/b&gt;&lt;/small&gt;</property>
                        <property name="use-markup">true</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                        <layout>
                          <property name="column">4</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">&lt;small&gt;&lt;b&gt;Newest&lt;/b&gt;&lt;/small&gt;</property>
                        <property name="use-markup">true</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="dim-label"/>
                        </style>
                        <layout>
                          <property name="column">5</property>
                          <property name="row">0</property>
                        </layout>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="noPackages_">
                <property name="label">package.json has no dependencies yet: add one below.</property>
                <property name="wrap">true</property>
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">4</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">8</property>
                <child>
                  <object class="GtkEntry" id="addName_">
                    <property name="hexpand">true</property>
                    <property name="placeholder-text">Add a package, e.g. zod or @company/ui</property>
                    <signal name="activate" handler="on_add_clicked"/>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="addVersion_">
                    <property name="width-chars">10</property>
                    <property name="placeholder-text">newest</property>
                    <property name="tooltip-text">A version (1.2.3) or tag (next); empty: the newest</property>
                    <signal name="activate" handler="on_add_clicked"/>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="addDev_">
                    <property name="label">Only for development</property>
                    <property name="tooltip-text">For building and testing only (devDependencies), not needed when the app runs</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton" id="addButton_">
                    <property name="label">Add</property>
                    <signal name="clicked" handler="on_add_clicked"/>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="addStatus_">
                <property name="xalign">0</property>
                <style>
                  <class name="dim-label"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel">
            <property name="label">Lock = always install exactly this version. Otherwise package.json says how far updates may go: ~ bug fixes only, ^ new features and fixes (npm's usual choice; nothing that should break your code), &gt;= anything newer, * any version. What's actually installed is written to the lockfile (package-lock.json, pnpm-lock.yaml…) until you install or update again.</property>
            <property name="wrap">true</property>
            <property name="xalign">0</property>
            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="error_">
            <property name="label">What stops the save</property>
            <property name="visible">false</property>
            <property name="wrap">true</property>
            <property name="xalign">0</property>
            <style>
              <class name="error"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkBox">
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkButton" id="cancel_">
                <property name="label">Cancel</property>
                <signal name="clicked" handler="on_cancel_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="save_">
                <property name="label">Save</property>
                <property name="tooltip-text">Write package.json and .npmrc; install later (Project → Install Dependencies)</property>
                <signal name="clicked" handler="on_save_clicked"/>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="install_">
                <property name="label">Save and Install</property>
                <property name="tooltip-text">Write package.json and .npmrc, then install the packages</property>
                <style>
                  <class name="suggested-action"/>
                </style>
                <signal name="clicked" handler="on_install_clicked"/>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
