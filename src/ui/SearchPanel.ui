<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkBox" id="SearchPanel">
    <property name="orientation">vertical</property>
    <property name="spacing">4</property>
    <property name="margin-top">4</property>
    <child>
      <object class="GtkBox">
        <property name="spacing">2</property>
        <property name="margin-start">4</property>
        <property name="margin-end">4</property>
        <child>
          <object class="GtkSearchEntry" id="query_">
            <property name="hexpand">true</property>
            <property name="placeholder-text">Find in files (Ctrl+Shift+F)</property>
            <property name="search-delay">250</property>
            <signal name="search-changed" handler="on_options_changed"/>
            <signal name="activate" handler="on_options_changed"/>
            <signal name="stop-search" handler="on_query_stop_search"/>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="matchCase_">
            <property name="tooltip-text">Match case</property>
            <property name="has-frame">false</property>
            <property name="focus-on-click">false</property>
            <property name="valign">center</property>
            <style>
              <class name="kevc-search-option"/>
            </style>
            <signal name="toggled" handler="on_options_changed"/>
            <child>
              <object class="GtkLabel">
                <property name="label">Aa</property>
                <property name="use-markup">true</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="wholeWord_">
            <property name="tooltip-text">Whole words only</property>
            <property name="has-frame">false</property>
            <property name="focus-on-click">false</property>
            <property name="valign">center</property>
            <style>
              <class name="kevc-search-option"/>
            </style>
            <signal name="toggled" handler="on_options_changed"/>
            <child>
              <object class="GtkLabel">
                <property name="label">&lt;u&gt;ab&lt;/u&gt;</property>
                <property name="use-markup">true</property>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkToggleButton" id="regex_">
            <property name="tooltip-text">Regular expression (ECMAScript, one line at a time)</property>
            <property name="has-frame">false</property>
            <property name="focus-on-click">false</property>
            <property name="valign">center</property>
            <style>
              <class name="kevc-search-option"/>
            </style>
            <signal name="toggled" handler="on_options_changed"/>
            <child>
              <object class="GtkLabel">
                <property name="label">.*</property>
                <property name="use-markup">true</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkBox">
        <property name="spacing">4</property>
        <property name="margin-start">4</property>
        <property name="margin-end">4</property>
        <child>
          <object class="GtkEntry" id="replace_">
            <property name="hexpand">true</property>
            <property name="placeholder-text">Replace with…</property>
            <property name="tooltip-text">What every match becomes when you press Replace All. With .* on, $1 inserts the first ( ) group of the match</property>
            <signal name="activate" handler="on_replace_all_clicked"/>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="replaceAll_">
            <property name="label">Replace All</property>
            <property name="sensitive">false</property>
            <property name="tooltip-text">Replace every match in the list (asks first)</property>
            <signal name="clicked" handler="on_replace_all_clicked"/>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkEntry" id="include_">
        <property name="placeholder-text">Files to include: *.cpp, src/, !tests/</property>
        <property name="tooltip-text">Comma-separated: *.h matches file names, src/ a folder, src/*.h paths; a leading ! leaves files out</property>
        <property name="margin-start">4</property>
        <property name="margin-end">4</property>
        <signal name="changed" handler="on_include_changed"/>
        <signal name="activate" handler="on_options_changed"/>
      </object>
    </child>
    <child>
      <object class="GtkLabel" id="summary_">
        <property name="wrap">true</property>
        <property name="xalign">0</property>
        <property name="margin-start">6</property>
        <property name="margin-end">4</property>
        <style>
          <class name="dim-label"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkScrolledWindow">
        <property name="vexpand">true</property>
        <child>
          <object class="GtkListView" id="list_">
            <property name="single-click-activate">true</property>
            <style>
              <class name="kevc-search-results"/>
            </style>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
