<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkScrolledWindow" id="CompilerPanel">
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkLabel" id="message_">
            <property name="label">Errors and warnings from builds appear here.</property>
            <property name="wrap">true</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>
            <property name="margin-bottom">12</property>
            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>
        <child>
          <object class="GtkListBox" id="list_">
            <property name="visible">false</property>
            <property name="activate-on-single-click">false</property>
            <property name="selection-mode">multiple</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <menu id="contextMenu_">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Copy</attribute>
        <attribute name="action">compiler.copy</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Copy _All</attribute>
        <attribute name="action">compiler.copy-all</attribute>
      </item>
    </section>
  </menu>
</interface>
